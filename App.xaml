<Application x:Class="TechFixStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <SolidColorBrush x:Key="BgBrush"
                         Color="#080B12"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#101621"/>

        <SolidColorBrush x:Key="Panel2Brush"
                         Color="#151D2A"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#263447"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#00E5FF"/>

        <SolidColorBrush x:Key="Accent2Brush"
                         Color="#8B5CF6"/>

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="WarningBrush"
                         Color="#F59E0B"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#EF4444"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#E6EDF7"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#8A99AD"/>

        <Style TargetType="{x:Type Window}">
            <Setter Property="Background"
                    Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="{StaticResource Panel2Brush}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="12,7"/>
            <Setter Property="Margin"
                    Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource AccentBrush}"/>
                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>