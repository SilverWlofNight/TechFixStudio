<Window x:Class="TechFixStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TechFix Studio"
        Width="1500"
        Height="920"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock
                        Text="TECHFIX STUDIO"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource AccentBrush}"/>

                    <TextBlock
                        Text="NATIVE WINDOWS REPAIR WORKSTATION"
                        FontSize="10"
                        Foreground="{StaticResource MutedBrush}"
                        Margin="0,3,0,0"/>

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Border
                        Background="#14291E"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,5"
                        Margin="8">

                        <TextBlock
                            Text="● ONLINE"
                            Foreground="{StaticResource SuccessBrush}"/>

                    </Border>

                    <TextBlock
                        Text="SAFE EXECUTION / AUDIT"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource MutedBrush}"
                        Margin="8"/>

                </StackPanel>

                <Button
                    Grid.Column="2"
                    Content="⟳  SCAN"
                    Click="ScanDevices_Click"
                    Width="110"
                    Height="36"
                    VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Row="1"
              Margin="0,12,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT -->

            <Border
                Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,12,0">

                <DockPanel>

                    <TextBlock
                        DockPanel.Dock="Top"
                        Text="WORKSPACE"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource MutedBrush}"
                        Margin="4,4,4,12"/>

                    <StackPanel
                        DockPanel.Dock="Top">

                        <Button Content="⌂  控制台"/>

                        <Button Content="▣  Android 设备中心"/>

                        <Button Content="⚡  刷机中心"/>

                        <Button Content="◈  Root / Magisk"/>

                        <Button Content="›_  终端工作台"/>

                        <Button Content="▰  Fastboot"/>

                        <Button Content="🛠  Windows 修复"/>

                        <Button Content="⌘  Linux / SSH"/>

                        <Button Content="◎  资源中心"/>

                        <Button Content="⚙  插件管理"/>

                    </StackPanel>

                    <Separator
                        Margin="0,14"/>

                    <TextBlock
                        Text="DEVICE QUEUE"
                        FontSize="10"
                        Foreground="{StaticResource MutedBrush}"
                        Margin="4,4,4,8"/>

                    <ListBox
                        ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding SelectedDevice}"
                        Background="Transparent"
                        BorderThickness="0">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8"
                                    Margin="0,3">

                                    <StackPanel>

                                        <TextBlock
                                            Text="{Binding Serial}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource AccentBrush}"/>

                                        <TextBlock
                                            Text="{Binding Transport}"
                                            FontSize="10"
                                            Foreground="{StaticResource MutedBrush}"/>

                                        <TextBlock
                                            Text="{Binding Model}"
                                            FontSize="11"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </DockPanel>

            </Border>


            <!-- RIGHT -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="250"/>
                </Grid.RowDefinitions>


                <!-- DEVICE -->

                <Border
                    Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="SELECTED DEVICE"
                                FontSize="10"
                                Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.Serial}"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}"
                                Margin="0,4"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.Model}"
                                Foreground="{StaticResource TextBrush}"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <Border
                                Background="{StaticResource Panel2Brush}"
                                Padding="12"
                                CornerRadius="5"
                                Margin="4">

                                <StackPanel>

                                    <TextBlock
                                        Text="TRANSPORT"
                                        FontSize="9"
                                        Foreground="{StaticResource MutedBrush}"/>

                                    <TextBlock
                                        Text="{Binding SelectedDevice.Transport}"
                                        FontWeight="Bold"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Background="{StaticResource Panel2Brush}"
                                Padding="12"
                                CornerRadius="5"
                                Margin="4">

                                <StackPanel>

                                    <TextBlock
                                        Text="SLOT"
                                        FontSize="9"
                                        Foreground="{StaticResource MutedBrush}"/>

                                    <TextBlock
                                        Text="{Binding SelectedDevice.CurrentSlot}"
                                        FontWeight="Bold"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Background="{StaticResource Panel2Brush}"
                                Padding="12"
                                CornerRadius="5"
                                Margin="4">

                                <StackPanel>

                                    <TextBlock
                                        Text="BOOTLOADER"
                                        FontSize="9"
                                        Foreground="{StaticResource MutedBrush}"/>

                                    <TextBlock
                                        Text="{Binding SelectedDevice.BootloaderUnlocked}"
                                        FontWeight="Bold"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- CENTER -->

                <Grid
                    Grid.Row="1"
                    Margin="0,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- DEVICE INFO -->

                    <Border
                        Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,6,0">

                        <StackPanel>

                            <TextBlock
                                Text="DEVICE INSPECTOR"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}"
                                Margin="0,0,0,14"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.Manufacturer,
                                       StringFormat=Manufacturer: {0}}"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.Model,
                                       StringFormat=Model: {0}}"
                                Margin="0,8"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.AndroidVersion,
                                       StringFormat=Android: {0}}"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.SdkVersion,
                                       StringFormat=SDK: {0}}"
                                Margin="0,8"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.CpuAbi,
                                       StringFormat=ABI: {0}}"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.Product,
                                       StringFormat=Product: {0}}"
                                Margin="0,8"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.RootDetected,
                                       StringFormat=Root detected: {0}}"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.AvbEnabled,
                                       StringFormat=AVB: {0}}"
                                Margin="0,8"/>

                            <TextBlock
                                Text="{Binding SelectedDevice.AntiRollback,
                                       StringFormat=Anti-Rollback: {0}}"/>

                        </StackPanel>

                    </Border>


                    <!-- FLASH CENTER -->

                    <Border
                        Grid.Column="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="6,0,0,0">

                        <DockPanel>

                            <StackPanel
                                DockPanel.Dock="Top">

                                <TextBlock
                                    Text="FLASH CENTER"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}"/>

                                <Button
                                    Content="+ ADD FLASH TASK"
                                    Click="AddFlashTask_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,12"/>

                            </StackPanel>

                            <ListBox
                                ItemsSource="{Binding FlashTasks}"
                                Background="Transparent"
                                BorderThickness="0">

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Background="{StaticResource Panel2Brush}"
                                            Padding="8"
                                            Margin="0,3"
                                            CornerRadius="5">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>

                                                    <TextBlock
                                                        Text="{Binding Partition}"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource AccentBrush}"/>

                                                    <TextBlock
                                                        Text="{Binding ImagePath}"
                                                        FontSize="10"
                                                        TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock
                                                        Text="{Binding State}"
                                                        FontSize="10"
                                                        Foreground="{StaticResource MutedBrush}"/>

                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    Content="EXECUTE"
                                                    Click="ExecuteFlash_Click"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </DockPanel>

                    </Border>

                </Grid>


                <!-- TERMINAL -->

                <Border
                    Grid.Row="2"
                    Background="#070A0F"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <TextBox
                            Text="{Binding Terminal, Mode=OneWay}"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AccentBrush}"
                            FontFamily="Consolas"/>

                        <Grid
                            Grid.Row="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}"
                                Background="{StaticResource PanelBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10"
                                FontFamily="Consolas"/>

                            <Button
                                Grid.Column="1"
                                Content="RUN"
                                Width="90"
                                Click="RunTerminal_Click"/>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>


        <!-- FOOTER -->

        <Border
            Grid.Row="2"
            Background="{StaticResource PanelBrush}"
            CornerRadius="5"
            Padding="10">

            <DockPanel>

                <TextBlock
                    Text="Native Windows • Real Process Execution • Audit Log"
                    Foreground="{StaticResource MutedBrush}"/>

                <TextBlock
                    DockPanel.Dock="Right"
                    Text="{Binding StatusText}"
                    Foreground="{StaticResource AccentBrush}"/>

            </DockPanel>

        </Border>

    </Grid>

</Window>





