<Window x:Class="TechFixStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TechFix Studio — Native Windows Repair Workstation"
        Width="1500"
        Height="950"
        MinWidth="1200"
        MinHeight="760"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- 页面 Tab 隐藏标题 -->
        <Style x:Key="HiddenTabStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Visibility" Value="Visible"/>
        </Style>

        <!-- 左侧导航 -->
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="3,3,3,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <!-- 页面标题 -->
        <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 小标题 -->
        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 面板 -->
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- TOP BAR -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#07111B"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="20">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="TECHFIX"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource Cyan}"/>

                    <TextBlock Text=" STUDIO"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock Text=" // NATIVE WINDOWS REPAIR WORKSTATION"
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>

                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="● ONLINE"
                               Foreground="{StaticResource Green}"
                               Margin="0,0,25,0"/>

                    <TextBlock Text="{Binding Clock}"
                               FontFamily="Consolas"
                               Margin="0,0,25,0"/>

                    <TextBlock Text="SAFE EXECUTION / AUDIT"
                               Foreground="{StaticResource Muted}"/>

                </StackPanel>

            </DockPanel>

        </Border>


        <!-- ========================================================= -->
        <!-- LEFT NAVIGATION -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#071019"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0"
                Padding="10">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="WORKSPACE"
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               Margin="8,8,8,10"/>


                    <Button Content="◈   控制台"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Dashboard_Click"/>

                    <Button Content="▣   Android 设备中心"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Android_Click"/>

                    <Button Content="⚡   刷机中心"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Flash_Click"/>

                    <Button Content="◉   Root / Magisk"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Root_Click"/>

                    <Button Content="⌘   ADB 终端工作台"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Terminal_Click"/>

                    <Button Content="▰   Fastboot"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Fastboot_Click"/>

                    <Button Content="▤   Windows 修复"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Windows_Click"/>

                    <Button Content="◌   Linux / SSH"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Ssh_Click"/>

                    <Button Content="◎   ROM 资源中心"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Rom_Click"/>

                    <Button Content="⚙   插件管理"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Plugin_Click"/>

                </StackPanel>


                <!-- DEVICE QUEUE -->

                <StackPanel DockPanel.Dock="Bottom">

                    <Separator Margin="5,8"/>

                    <TextBlock Text="DEVICE QUEUE"
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               Margin="8,5"/>

                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             Background="Transparent"
                             BorderThickness="0"
                             Height="150">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="{StaticResource Panel2}"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="8"
                                        Margin="2">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Model}"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding Serial}"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="9"/>

                                        <TextBlock Text="{Binding Transport}"
                                                   Foreground="{StaticResource Cyan}"
                                                   FontSize="9"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>


                    <Button Content="⟳  重新扫描设备"
                            Height="38"
                            Click="Refresh_Click"/>

                </StackPanel>

            </DockPanel>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN WORKSPACE -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{StaticResource Bg}">

            <TabControl x:Name="WorkspaceTabs"
                        BorderThickness="0"
                        Background="Transparent"
                        SelectedIndex="0">

                <!-- ================================================= -->
                <!-- 0 DASHBOARD -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="18">

                            <TextBlock Text="维修控制台 / DASHBOARD"
                                       Style="{StaticResource PageTitleStyle}"/>

                            <TextBlock Text="{Binding Status}"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,15"/>


                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!-- Device -->

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="SELECTED DEVICE"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <TextBlock Text="{Binding SelectedDevice.Model, TargetNullValue=No device}"
                                                   FontSize="25"/>

                                        <TextBlock Text="{Binding SelectedDevice.Serial}"
                                                   Foreground="{StaticResource Muted}"
                                                   FontFamily="Consolas"
                                                   Margin="0,5"/>

                                        <TextBlock Text="{Binding SelectedDevice.Android}"
                                                   Foreground="{StaticResource Purple}"
                                                   Margin="0,5"/>

                                        <TextBlock Text="{Binding SelectedDevice.Transport}"
                                                   Foreground="{StaticResource Cyan}"/>

                                        <WrapPanel Margin="0,15,0,0">

                                            <Button Content="扫描设备"
                                                    Click="Refresh_Click"/>

                                            <Button Content="Android 中心"
                                                    Click="Android_Click"/>

                                            <Button Content="Fastboot"
                                                    Click="Fastboot_Click"/>

                                        </WrapPanel>

                                    </StackPanel>

                                </Border>


                                <!-- Telemetry -->

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="REAL-TIME TELEMETRY"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <TextBlock Text="CPU / HOST"
                                                   Foreground="{StaticResource Cyan}"/>

                                        <ProgressBar Value="{Binding Cpu}"
                                                     Maximum="100"
                                                     Height="8"
                                                     Margin="0,5,0,10"/>

                                        <TextBlock Text="RAM / HOST"
                                                   Foreground="{StaticResource Cyan}"/>

                                        <ProgressBar Value="{Binding Ram}"
                                                     Maximum="100"
                                                     Height="8"
                                                     Margin="0,5,0,10"/>

                                        <TextBlock Text="{Binding Battery, StringFormat=DEVICE BATTERY: {0:F0}%}"
                                                   Foreground="{StaticResource Green}"/>

                                        <TextBlock Text="{Binding BatteryTemp, StringFormat=DEVICE TEMP: {0:F1} °C}"
                                                   Foreground="{StaticResource Green}"
                                                   Margin="0,5"/>

                                    </StackPanel>

                                </Border>

                            </Grid>


                            <Grid Margin="0,5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="ANDROID"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <TextBlock Text="ADB Device Discovery"
                                                   FontSize="16"/>

                                        <Button Content="打开 Android 设备中心"
                                                Click="Android_Click"
                                                Margin="0,12,0,0"/>

                                    </StackPanel>

                                </Border>


                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="FLASH"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <TextBlock Text="Controlled Fastboot Queue"
                                                   FontSize="16"/>

                                        <Button Content="打开刷机中心"
                                                Click="Flash_Click"
                                                Margin="0,12,0,0"/>

                                    </StackPanel>

                                </Border>


                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="WINDOWS"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <TextBlock Text="SFC / DISM Repair"
                                                   FontSize="16"/>

                                        <Button Content="打开 Windows 修复"
                                                Click="Windows_Click"
                                                Margin="0,12,0,0"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ================================================= -->
                <!-- 1 ANDROID -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="18">

                            <TextBlock Text="Android 设备中心"
                                       Style="{StaticResource PageTitleStyle}"/>

                            <TextBlock Text="ADB device discovery / properties / telemetry"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,15"/>


                            <Border Style="{StaticResource CardStyle}">

                                <StackPanel>

                                    <TextBlock Text="DEVICE LIST"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <Button Content="⟳ 立即扫描 ADB / Fastboot"
                                            Click="Refresh_Click"
                                            HorizontalAlignment="Left"/>

                                    <ListBox ItemsSource="{Binding Devices}"
                                             SelectedItem="{Binding SelectedDevice}"
                                             Margin="0,10"
                                             MinHeight="180">

                                        <ListBox.ItemTemplate>

                                            <DataTemplate>

                                                <Border Background="{StaticResource Panel2}"
                                                        BorderBrush="{StaticResource Line}"
                                                        BorderThickness="1"
                                                        Padding="12"
                                                        Margin="3">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Model}"
                                                                   FontWeight="Bold"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Serial}"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{StaticResource Muted}"/>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Transport}"
                                                                   Foreground="{StaticResource Cyan}"/>

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Android}"
                                                                   Foreground="{StaticResource Purple}"/>

                                                    </Grid>

                                                </Border>

                                            </DataTemplate>

                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource CardStyle}">

                                <StackPanel>

                                    <TextBlock Text="SELECTED DEVICE DETAILS"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="{Binding SelectedDevice.Model, TargetNullValue=未选择设备}"
                                                       FontSize="22"/>

                                            <TextBlock Text="{Binding SelectedDevice.Serial}"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource Muted}"
                                                       Margin="0,5"/>

                                            <TextBlock Text="{Binding SelectedDevice.Android}"
                                                       Foreground="{StaticResource Purple}"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock Text="{Binding SelectedDevice.Root, StringFormat=ROOT: {0}}"
                                                       Foreground="{StaticResource Green}"/>

                                            <TextBlock Text="{Binding SelectedDevice.Slot, StringFormat=SLOT: {0}}"
                                                       Foreground="{StaticResource Green}"
                                                       Margin="0,5"/>

                                            <TextBlock Text="{Binding Battery, StringFormat=BATTERY: {0:F0}%}"
                                                       Foreground="{StaticResource Cyan}"/>

                                            <TextBlock Text="{Binding BatteryTemp, StringFormat=TEMP: {0:F1} °C}"
                                                       Foreground="{StaticResource Cyan}"
                                                       Margin="0,5"/>

                                        </StackPanel>

                                    </Grid>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ================================================= -->
                <!-- 2 FLASH -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="18">

                            <TextBlock Text="刷机中心 / FLASH CENTER"
                                       Style="{StaticResource PageTitleStyle}"/>

                            <TextBlock Text="SHA-256 verification + controlled fastboot flashing"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,15"/>


                            <!-- Factory -->

                            <Border Style="{StaticResource CardStyle}">

                                <StackPanel>

                                    <TextBlock Text="FACTORY / ROM ANALYZER"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <WrapPanel>

                                        <Button Content="选择 ROM / Factory ZIP / IMG"
                                                Click="BrowseFactory_Click"/>

                                    </WrapPanel>

                                    <TextBox Text="{Binding FactoryText}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             Height="160"
                                             FontFamily="Consolas"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>

                                </StackPanel>

                            </Border>


                            <!-- Flash Queue -->

                            <Border Style="{StaticResource CardStyle}">

                                <StackPanel>

                                    <TextBlock Text="CONTROLLED FLASH QUEUE"
                                               Style="{StaticResource SectionTitleStyle}"/>


                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="PARTITION"
                                                   VerticalAlignment="Center"/>

                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Partitions}"
                                                  SelectedItem="{Binding FlashPartition}"/>

                                    </Grid>


                                    <Grid Margin="0,8,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="IMAGE"
                                                   VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding FlashPath, UpdateSourceTrigger=PropertyChanged}"/>

                                        <Button Grid.Column="2"
                                                Content="浏览"
                                                Click="BrowseFlash_Click"/>

                                    </Grid>


                                    <Grid Margin="0,8,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="SHA-256"
                                                   VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding FlashHash, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"/>

                                    </Grid>


                                    <TextBlock Text="{Binding FlashStatus}"
                                               Foreground="{StaticResource Amber}"
                                               Margin="0,8"/>


                                    <WrapPanel>

                                        <Button Content="＋ 加入队列"
                                                Click="AddTask_Click"/>

                                        <Button Content="▶ 启动队列"
                                                Click="RunQueue_Click"/>

                                        <Button Content="■ 取消"
                                                Click="CancelQueue_Click"/>

                                    </WrapPanel>


                                    <ListBox ItemsSource="{Binding FlashQueue}"
                                             Height="220"
                                             Background="#04080D"
                                             Margin="0,10,0,0">

                                        <ListBox.ItemTemplate>

                                            <DataTemplate>

                                                <Grid Margin="4">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Partition}"
                                                               Foreground="{StaticResource Cyan}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Serial}"
                                                               Foreground="{StaticResource Muted}"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding State}"/>

                                                    <ProgressBar Grid.Column="3"
                                                                 Value="{Binding Progress}"
                                                                 Maximum="100"
                                                                 Height="7"
                                                                 VerticalAlignment="Center"
                                                                 Margin="5"/>

                                                    <Button Grid.Column="4"
                                                            Content="删除"
                                                            Click="RemoveTask_Click"/>

                                                </Grid>

                                            </DataTemplate>

                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ================================================= -->
                <!-- 3 ROOT / MAGISK -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="18">

                            <TextBlock Text="Root / Magisk"
                                       Style="{StaticResource PageTitleStyle}"/>

                            <TextBlock Text="Android root status and image workflow"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,15"/>


                            <Border Style="{StaticResource CardStyle}">

                                <StackPanel>

                                    <TextBlock Text="ROOT STATUS"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock Text="{Binding SelectedDevice.Model, TargetNullValue=未选择设备}"
                                               FontSize="24"/>

                                    <TextBlock Text="{Binding SelectedDevice.Serial}"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource Muted}"
                                               Margin="0,5"/>

                                    <TextBlock Text="{Binding SelectedDevice.Root, StringFormat=ROOT STATUS: {0}}"
                                               Foreground="{StaticResource Green}"
                                               FontSize="17"
                                               Margin="0,10"/>

                                    <WrapPanel>

                                        <Button Content="重新检测设备"
                                                Click="Refresh_Click"/>

                                        <Button Content="打开 Android 设备中心"
                                                Click="Android_Click"/>

                                        <Button Content="打开刷机中心"
                                                Click="Flash_Click"/>

                                    </WrapPanel>

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource CardStyle}">

                                <StackPanel>

                                    <TextBlock Text="MAGISK WORKFLOW"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock Text="当前版本已连接 Root 状态检测与 Factory/Image 分析能力。"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Boot / Init_Boot 镜像应通过刷机中心进行 SHA-256 校验和受控执行。"
                                               Foreground="{StaticResource Muted}"
                                               TextWrapping="Wrap"
                                               Margin="0,8"/>

                                    <Button Content="进入受控刷机中心"
                                            Click="Flash_Click"
                                            HorizontalAlignment="Left"
                                            Margin="0,12,0,0"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ================================================= -->
                <!-- 4 TERMINAL -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="ADB 终端工作台"
                                   Style="{StaticResource PageTitleStyle}"/>


                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         Height="40"
                                         VerticalContentAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Content="执行"
                                        Click="Execute_Click"
                                        Height="40"/>

                            </Grid>

                        </Border>


                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}">

                            <TextBox Text="{Binding Terminal}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>

                        </Border>

                    </Grid>

                </TabItem>


                <!-- ================================================= -->
                <!-- 5 FASTBOOT -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="Fastboot 工作台"
                                   Style="{StaticResource PageTitleStyle}"/>


                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="{Binding SelectedDevice.Model, TargetNullValue=未选择 Fastboot 设备}"
                                           FontSize="22"/>

                                <TextBlock Text="{Binding SelectedDevice.Serial}"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource Muted}"
                                           Margin="0,5"/>

                                <WrapPanel>

                                    <Button Content="扫描设备"
                                            Click="Refresh_Click"/>

                                    <Button Content="读取 Fastboot 信息"
                                            Click="Fastboot_Click"/>

                                    <Button Content="进入刷机中心"
                                            Click="Flash_Click"/>

                                </WrapPanel>

                            </StackPanel>

                        </Border>


                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}">

                            <TextBox Text="{Binding Terminal}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>

                        </Border>

                    </Grid>

                </TabItem>


                <!-- ================================================= -->
                <!-- 6 WINDOWS REPAIR -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="Windows 系统修复"
                                   Style="{StaticResource PageTitleStyle}"/>


                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="SYSTEM REPAIR"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="以下操作调用真实 Windows 系统工具。部分操作需要管理员权限。"
                                           Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <WrapPanel>

                                    <Button Content="SFC /scannow"
                                            Click="Sfc_Click"/>

                                    <Button Content="DISM CheckHealth"
                                            Click="DismCheck_Click"/>

                                    <Button Content="DISM RestoreHealth"
                                            Click="Dism_Click"/>

                                </WrapPanel>

                            </StackPanel>

                        </Border>


                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}">

                            <TextBox Text="{Binding Terminal}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>

                        </Border>

                    </Grid>

                </TabItem>


                <!-- ================================================= -->
                <!-- 7 SSH -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="Linux / SSH"
                                   Style="{StaticResource PageTitleStyle}"/>


                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="SSH EXECUTOR"
                                           Style="{StaticResource SectionTitleStyle}"/>


                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>


                                    <TextBox Grid.Column="0"
                                             Text="{Binding SshHost, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="SSH Host"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding SshUser, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="SSH User"/>

                                    <TextBox Grid.Column="2"
                                             Text="{Binding SshCommand, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"/>

                                    <Button Grid.Column="3"
                                            Content="SSH 执行"
                                            Click="Ssh_Click"/>

                                </Grid>

                            </StackPanel>

                        </Border>


                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}">

                            <TextBox Text="{Binding SshOutput}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>

                        </Border>

                    </Grid>

                </TabItem>


                <!-- ================================================= -->
                <!-- 8 ROM RESOURCE -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="ROM 资源中心"
                                   Style="{StaticResource PageTitleStyle}"/>


                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="FACTORY IMAGE / ROM ANALYZER"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="选择 ZIP / IMG / BIN 后进行本地分析和 SHA-256 计算。"
                                           Foreground="{StaticResource Muted}"
                                           Margin="0,0,0,10"/>

                                <Button Content="选择 ROM / Factory ZIP / IMG"
                                        Click="BrowseFactory_Click"
                                        HorizontalAlignment="Left"/>

                            </StackPanel>

                        </Border>


                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}">

                            <TextBox Text="{Binding FactoryText}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                        </Border>

                    </Grid>

                </TabItem>


                <!-- ================================================= -->
                <!-- 9 PLUGIN -->
                <!-- ================================================= -->

                <TabItem Style="{StaticResource HiddenTabStyle}">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="插件管理"
                                   Style="{StaticResource PageTitleStyle}"/>


                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="MODULE MANAGER"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="TechFix Studio 模块目录"
                                           FontSize="18"/>

                                <TextBlock Text="插件目录位于程序数据目录中。"
                                           Foreground="{StaticResource Muted}"
                                           Margin="0,8"/>

                                <TextBlock x:Name="ModulePathText"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource Cyan}"
                                           TextWrapping="Wrap"
                                           Margin="0,5"/>

                                <WrapPanel Margin="0,15,0,0">

                                    <Button Content="打开插件目录"
                                            Click="OpenModules_Click"/>

                                    <Button Content="刷新界面"
                                            Click="Refresh_Click"/>

                                </WrapPanel>


                                <Border Background="#050B12"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        Padding="12"
                                        Margin="0,20,0,0">

                                    <TextBlock Text="模块安全说明：插件不应绕过 TechFix Studio 的风险分析、审计和受控执行机制。"
                                               Foreground="{StaticResource Muted}"
                                               TextWrapping="Wrap"/>

                                </Border>

                            </StackPanel>

                        </Border>

                    </Grid>

                </TabItem>

            </TabControl>

        </Border>


        <!-- ========================================================= -->
        <!-- STATUS BAR -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="#050A10">

            <DockPanel Margin="12,0">

                <TextBlock Text="Native Windows • Real Process Execution • SHA-256 • Audit Log • Controlled Flashing"
                           Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"/>

                <TextBlock DockPanel.Dock="Right"
                           Text="TECHFIX STUDIO 1.1.0"
                           Foreground="{StaticResource Cyan}"
                           VerticalAlignment="Center"/>

            </DockPanel>

        </Border>

    </Grid>

</Window>

