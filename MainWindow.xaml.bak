<Window x:Class="TechFixStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TechFix Studio"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#070B12"
        Foreground="#DDE7F5">

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#0D1420"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#111B29"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#26384D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="#7C4DFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#DDE7F5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7F91A8"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#111B29"/>
            <Setter Property="Foreground" Value="#DDE7F5"/>
            <Setter Property="BorderBrush" Value="#26384D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17283B"/>
                    <Setter Property="BorderBrush" Value="#00D9FF"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#203A52"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#10283A"/>
            <Setter Property="BorderBrush" Value="#00D9FF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#080E17"/>
            <Setter Property="Foreground" Value="#DDE7F5"/>
            <Setter Property="BorderBrush" Value="#26384D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#080E17"/>
            <Setter Property="Foreground" Value="#DDE7F5"/>
            <Setter Property="BorderBrush" Value="#26384D"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#17364B"/>
                    <Setter Property="BorderBrush" Value="#00D9FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="BorderBrush" Value="#26384D"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#090F18"
                BorderBrush="#26384D"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="TECHFIX STUDIO"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#00D9FF"/>

                    <TextBlock Text="NATIVE WINDOWS REPAIR WORKSTATION"
                               FontSize="10"
                               Foreground="#7F91A8"
                               Margin="2,2,0,0"/>

                </StackPanel>

                <Border Grid.Column="1"
                        Background="#0D1824"
                        BorderBrush="#26384D"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,7"
                        Margin="0,0,12,0">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#00D9FF"
                                 Margin="0,0,7,0"/>

                        <TextBlock Text="ONLINE"
                                   Foreground="#DDE7F5"/>

                    </StackPanel>

                </Border>

                <Button Grid.Column="2"
                        Content="⟳  SCAN DEVICES"
                        Width="145"
                        Style="{StaticResource ActionButton}"
                        Click="Scan_Click"/>

            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="#090F18"
                    BorderBrush="#26384D"
                    BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="8,14">

                            <TextBlock Text="WORKSTATION"
                                       Foreground="#50657D"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="12,0,0,8"/>

                            <Button Content="⌂  控制台"
                                    Tag="Dashboard"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="▣  Android 设备中心"
                                    Tag="Android"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="⚡  刷机中心"
                                    Tag="Flash"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="●  Root / Magisk"
                                    Tag="Root"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="⌘  ADB 终端"
                                    Tag="Terminal"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="⚙  Fastboot"
                                    Tag="Fastboot"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="▤  Windows 修复"
                                    Tag="Windows"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="λ  Linux / SSH"
                                    Tag="Linux"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="◎  资源中心"
                                    Tag="Resources"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                            <Button Content="◆  插件管理"
                                    Tag="Plugins"
                                    Style="{StaticResource NavButton}"
                                    Click="Navigation_Click"/>

                        </StackPanel>

                    </ScrollViewer>

                    <Border Grid.Row="1"
                            BorderBrush="#26384D"
                            BorderThickness="0,1,0,0"
                            Padding="12">

                        <StackPanel>

                            <TextBlock Text="SYSTEM"
                                       Foreground="#50657D"
                                       FontSize="10"/>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#00D9FF"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Column="1"
                  Margin="18">

                <!-- DASHBOARD -->
                <Grid x:Name="DashboardPage">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">

                        <TextBlock Text="CONTROL CONSOLE"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#DDE7F5"/>

                        <TextBlock Text="设备检测、维修任务与操作状态"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="CONNECTED DEVICES"
                                  Grid.Column="0"
                                  Margin="0,0,10,0">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <Border Padding="10"
                                                    Margin="2"
                                                    BorderBrush="#26384D"
                                                    BorderThickness="0,0,0,1">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>

                                                        <TextBlock Text="{Binding Serial}"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"/>

                                                        <TextBlock Text="{Binding Transport}"
                                                                   Foreground="#00D9FF"
                                                                   Margin="0,3,0,0"/>

                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="CONNECTED"
                                                               Foreground="#68E0A0"
                                                               VerticalAlignment="Center"/>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                                <Button Grid.Row="1"
                                        Content="⟳  重新检测设备"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Right"
                                        Width="150"
                                        Click="Scan_Click"/>

                            </Grid>

                        </GroupBox>

                        <GroupBox Grid.Column="1"
                                  Header="DEVICE INSPECTOR">

                            <StackPanel>

                                <TextBlock Text="Selected Device"
                                           Foreground="#7F91A8"/>

                                <TextBlock Text="{Binding SelectedDevice.Serial, TargetNullValue=No device}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Margin="0,6,0,15"/>

                                <TextBlock Text="Transport"
                                           Foreground="#7F91A8"/>

                                <TextBlock Text="{Binding SelectedDevice.Transport, TargetNullValue=Unknown}"
                                           Foreground="#00D9FF"
                                           Margin="0,5,0,15"/>

                                <TextBlock Text="Status"
                                           Foreground="#7F91A8"/>

                                <TextBlock Text="{Binding StatusText}"
                                           Margin="0,5,0,15"/>

                                <Button Content="打开 Android 中心"
                                        Tag="Android"
                                        Style="{StaticResource ActionButton}"
                                        Click="Navigation_Click"/>

                            </StackPanel>

                        </GroupBox>

                    </Grid>

                </Grid>

                <!-- ANDROID -->
                <Grid x:Name="AndroidPage"
                      Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="ANDROID DEVICE CENTER"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ADB / Fastboot 设备检测"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,15"/>

                        <GroupBox Header="DEVICES">

                            <StackPanel>

                                <ListBox ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                         Height="350">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <StackPanel Margin="5">

                                                <TextBlock Text="{Binding Serial}"
                                                           FontSize="15"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding Transport}"
                                                           Foreground="#00D9FF"
                                                           Margin="0,3,0,0"/>

                                            </StackPanel>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                                <Button Content="⟳  SCAN ADB / FASTBOOT"
                                        Style="{StaticResource ActionButton}"
                                        Width="220"
                                        HorizontalAlignment="Left"
                                        Click="Scan_Click"/>

                            </StackPanel>

                        </GroupBox>

                    </StackPanel>

                </Grid>

                <!-- FLASH -->
                <Grid x:Name="FlashPage"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock Text="FLASH CENTER"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Fastboot 镜像刷写任务队列"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,15"/>

                    </StackPanel>

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">

                            <Button Content="＋  添加刷机任务"
                                    Width="160"
                                    Style="{StaticResource ActionButton}"
                                    Click="AddFlash_Click"/>

                            <Button Content="⟳  刷新队列"
                                    Width="130"
                                    Click="LoadFlash_Click"/>

                            <Button Content="▶  执行选中任务"
                                    Width="160"
                                    Click="ExecuteFlash_Click"/>

                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 x:Name="FlashTaskList"
                                 ItemsSource="{Binding FlashTasks}"
                                 Margin="0,12,0,0">

                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <Border BorderBrush="#26384D"
                                            BorderThickness="1"
                                            Padding="12"
                                            Margin="3">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>

                                                <TextBlock Text="{Binding Partition}"
                                                           FontSize="16"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding ImagePath}"
                                                           Foreground="#7F91A8"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0"/>

                                                <TextBlock Text="{Binding Serial}"
                                                           Foreground="#00D9FF"
                                                           Margin="0,4,0,0"/>

                                                <TextBlock Text="{Binding Message}"
                                                           Margin="0,4,0,0"/>

                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding State}"
                                                       Foreground="#00D9FF"
                                                       VerticalAlignment="Center"
                                                       Margin="15,0,0,0"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Grid>

                <!-- ROOT -->
                <Grid x:Name="RootPage"
                      Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="ROOT / MAGISK"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Root 状态检测与 Magisk 工作区"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,20"/>

                        <GroupBox Header="CURRENT DEVICE">

                            <StackPanel>

                                <TextBlock Text="{Binding SelectedDevice.Serial, TargetNullValue=未选择设备}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding SelectedDevice.Transport, TargetNullValue=Unknown}"
                                           Foreground="#00D9FF"
                                           Margin="0,7,0,20"/>

                                <TextBlock Text="Root 状态由 Android 设备扫描结果提供。"
                                           Foreground="#7F91A8"/>

                                <TextBlock Text="Magisk 镜像修补与刷写必须在确认目标镜像后执行。"
                                           Foreground="#7F91A8"
                                           Margin="0,5,0,20"/>

                                <Button Content="⟳  重新检测 Root / 设备"
                                        Style="{StaticResource ActionButton}"
                                        Width="210"
                                        HorizontalAlignment="Left"
                                        Click="Scan_Click"/>

                            </StackPanel>

                        </GroupBox>

                    </StackPanel>

                </Grid>

                <!-- TERMINAL -->
                <Grid x:Name="TerminalPage"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock Text="ADB TERMINAL"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="安全 ADB 命令执行器"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,12"/>

                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding TerminalOutput, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13"/>

                    <Grid Grid.Row="2"
                          Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="▶  RUN"
                                Width="110"
                                Height="42"
                                Style="{StaticResource ActionButton}"
                                Click="RunTerminal_Click"/>

                    </Grid>

                </Grid>

                <!-- FASTBOOT -->
                <Grid x:Name="FastbootPage"
                      Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="FASTBOOT"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Fastboot 设备检测与刷写入口"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,20"/>

                        <GroupBox Header="FASTBOOT DEVICES">

                            <StackPanel>

                                <ListBox ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                         Height="300">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <StackPanel Margin="5">

                                                <TextBlock Text="{Binding Serial}"
                                                           FontWeight="Bold"
                                                           FontSize="16"/>

                                                <TextBlock Text="{Binding Transport}"
                                                           Foreground="#00D9FF"
                                                           Margin="0,3,0,0"/>

                                            </StackPanel>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Button Content="⟳  检测"
                                            Width="120"
                                            Style="{StaticResource ActionButton}"
                                            Click="Scan_Click"/>

                                    <Button Content="⚡  添加刷机任务"
                                            Width="160"
                                            Click="AddFlash_Click"/>

                                </StackPanel>

                            </StackPanel>

                        </GroupBox>

                    </StackPanel>

                </Grid>

                <!-- WINDOWS -->
                <Grid x:Name="WindowsPage"
                      Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="WINDOWS REPAIR"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="SFC / DISM 系统修复工具"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,20"/>

                        <GroupBox Header="SYSTEM REPAIR">

                            <StackPanel>

                                <TextBlock Text="SFC"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <TextBlock Text="扫描并修复受保护的 Windows 系统文件。"
                                           Foreground="#7F91A8"
                                           Margin="0,4,0,8"/>

                                <Button Content="▶  运行 SFC"
                                        Width="150"
                                        Style="{StaticResource ActionButton}"
                                        Click="Sfc_Click"/>

                                <Separator Margin="0,18"/>

                                <TextBlock Text="DISM RestoreHealth"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <TextBlock Text="修复 Windows Component Store。"
                                           Foreground="#7F91A8"
                                           Margin="0,4,0,8"/>

                                <Button Content="▶  运行 DISM"
                                        Width="150"
                                        Style="{StaticResource ActionButton}"
                                        Click="Dism_Click"/>

                            </StackPanel>

                        </GroupBox>

                    </StackPanel>

                </Grid>

                <!-- LINUX -->
                <Grid x:Name="LinuxPage"
                      Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="LINUX / SSH"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Linux / SSH 工作区"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,20"/>

                        <GroupBox Header="SSH">

                            <StackPanel>

                                <TextBlock Text="当前版本的 SSH 功能通过 ViewModel 的安全执行接口提供。"
                                           Foreground="#7F91A8"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="如需完整 SSH / SFTP 浏览器，需要继续扩展 SshService 和 ViewModel 接口。"
                                           Foreground="#7F91A8"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,20"/>

                                <Button Content="打开终端工作区"
                                        Tag="Terminal"
                                        Style="{StaticResource ActionButton}"
                                        Width="180"
                                        Click="Navigation_Click"/>

                            </StackPanel>

                        </GroupBox>

                    </StackPanel>

                </Grid>

                <!-- RESOURCES -->
                <Grid x:Name="ResourcesPage"
                      Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="RESOURCE CENTER"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ROM / 工具 / 官方资源工作区"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,20"/>

                        <GroupBox Header="RESOURCE HUB">

                            <StackPanel>

                                <TextBlock Text="资源中心基础框架已经预留。"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <TextBlock Text="后续可以接入官方 ROM、Platform-Tools、OEM 解锁说明、Windows 镜像和 Linux 资源索引。"
                                           Foreground="#7F91A8"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,15"/>

                                <TextBlock Text="建议资源记录保存：名称、版本、官方 URL、SHA-256、适用设备。"
                                           Foreground="#7F91A8"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </GroupBox>

                    </StackPanel>

                </Grid>

                <!-- PLUGINS -->
                <Grid x:Name="PluginsPage"
                      Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="PLUGIN MANAGER"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="模块化插件工作区"
                                   Foreground="#7F91A8"
                                   Margin="0,4,0,20"/>

                        <GroupBox Header="PLUGINS">

                            <StackPanel>

                                <TextBlock Text="插件系统基础页面"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <TextBlock Text="后续可以继续接入模块扫描、启用/禁用、版本和安全签名检查。"
                                           Foreground="#7F91A8"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,15"/>

                                <TextBlock Text="当前核心维修功能不依赖第三方插件。"
                                           Foreground="#7F91A8"/>

                            </StackPanel>

                        </GroupBox>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="#090F18"
                BorderBrush="#26384D"
                BorderThickness="0,1,0,0">

            <Grid Margin="15,0">

                <TextBlock Text="Native Windows · Real Process Execution · Audit Log READY"
                           Foreground="#50657D"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding StatusText}"
                           Foreground="#00D9FF"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>

