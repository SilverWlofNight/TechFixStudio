using System.Windows;
using TechFixStudio.Models;
using TechFixStudio.ViewModels;

namespace TechFixStudio;

public partial class MainWindow : Window
{
    public MainWindow()
    {
        InitializeComponent();

        DataContext =
            new MainViewModel();
    }

    MainViewModel VM =>
        (MainViewModel)DataContext;

    async void Refresh_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RefreshAsync();
    }

    async void Execute_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RunCommandAsync();
    }

    async void Sfc_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RunSfcAsync();
    }

    async void DismCheck_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RunDismCheckAsync();
    }

    async void Dism_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RunDismAsync();
    }

    async void BrowseFactory_Click(
        object sender,
        RoutedEventArgs e)
    {
        var dialog =
            new Microsoft.Win32.OpenFileDialog
            {
                Filter =
                    "Factory / ROM|*.zip;*.img;*.bin|" +
                    "All files|*.*"
            };

        if (dialog.ShowDialog() == true)
        {
            await VM.InspectFactoryAsync(
                dialog.FileName);
        }
    }

    void BrowseFlash_Click(
        object sender,
        RoutedEventArgs e)
    {
        var dialog =
            new Microsoft.Win32.OpenFileDialog
            {
                Filter =
                    "Android image|*.img;*.bin|" +
                    "All files|*.*"
            };

        if (dialog.ShowDialog() == true)
        {
            VM.FlashPath =
                dialog.FileName;
        }
    }

    async void AddTask_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.AddTaskAsync();
    }

    async void RunQueue_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RunQueueAsync();
    }

    async void CancelQueue_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.CancelQueueAsync();
    }

    async void RemoveTask_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RemoveTaskAsync(
            (sender as FrameworkElement)
                ?.DataContext as FlashTask);
    }

    async void Fastboot_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.FastbootInfoAsync();
    }

    async void Ssh_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RunSshAsync();
    }

    //
    // Android 2.0
    //

    async void DiagnoseAndroid_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.DiagnoseAndroidAsync();
    }

    async void Logcat_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.LoadLogcatAsync();
    }

    async void RootMagisk_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.InspectRootMagiskAsync();
    }

    async void RebootBootloader_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RebootBootloaderAsync();
    }

    async void RebootRecovery_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.RebootRecoveryAsync();
    }

    //
    // Flash Center 2.0
    //

    async void BuildFlashPlan_Click(
        object sender,
        RoutedEventArgs e)
    {
        await VM.BuildFlashPlanAsync();
    }

    async void PrepareFlash_Click(
        object sender,
        RoutedEventArgs e)
    {
        if ((sender as FrameworkElement)
            ?.DataContext is FlashPlanItem item)
        {
            await VM.PrepareFlashImageAsync(
                item);
        }
    }
}
